# Local Node.js settings. Copy to .env.local when customization is needed.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/aes-portal.sqlite
# Required before binding the Node app beyond localhost. Browser username: aes
# PORTAL_PASSWORD=choose-a-strong-password
# Enables /api/v1/integration/* for the other backend app.
# API_KEY=choose-a-long-random-api-key
# ALLOWED_ORIGINS=https://your-other-app.example
