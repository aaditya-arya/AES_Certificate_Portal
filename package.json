{
  "name": "akshar-inspection-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node --env-file-if-exists=.env.local server/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/node-browser.mjs",
    "test:standards": "node tests/node-browser.mjs",
    "test:ux": "node tests/node-browser.mjs",
    "test:sample": "node tests/node-browser.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "db:generate": "drizzle-kit generate",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
